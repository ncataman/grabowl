{
  "name": "insdown",
  "displayName": "InsDown",
  "version": "1.0.0",
  "description": "Free downloader for Instagram photos, videos, reels, carousels and stories.",
  "author": "ncataman <info@ncataman.com>",
  "license": "MIT",
  "homepage": "https://insdown.app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:all": "npm run build && npm run build:firefox && npm run build:edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run compile && npm test && npm run build",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
